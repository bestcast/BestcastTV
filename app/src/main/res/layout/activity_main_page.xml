<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".main_page.MainPageActivity">

    <!-- Primary Content Container -->
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:nextFocusLeft="@id/blfNavBar" />

    <!-- Backdrop Dim Scrim Overlay over content when side navigation expands -->
    <View
        android:id="@+id/navScrimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:alpha="0"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false" />

    <!-- Side Navigation Panels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Main Navigation Rail / Drawer -->
        <androidx.leanback.widget.BrowseFrameLayout
            android:id="@+id/blfNavBar"
            android:layout_width="@dimen/side_nav_width_collapsed"
            android:layout_height="match_parent"
            android:background="@drawable/bg_side_nav_drawer"
            android:nextFocusRight="@id/container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:orientation="vertical">

                <!-- Profile Header -->
                <LinearLayout
                    android:id="@+id/profileContainer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/side_nav_item_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/profileImage"
                        android:layout_width="@dimen/side_nav_profile_size"
                        android:layout_height="@dimen/side_nav_profile_size"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/default_profile" />

                    <TextView
                        android:id="@+id/profileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="profile name"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/side_nav_profile_text_size"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:alpha="0" />

                </LinearLayout>

                <!-- Navigation Menu Items -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/btn_search"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/side_nav_item_height"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/nav_item_selector"
                        android:drawableLeft="@drawable/baseline_search_24"
                        android:drawableTint="@color/nav_item_icon_selector"
                        android:drawablePadding="@dimen/side_nav_item_icon_padding"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:text="Search"
                        android:textColor="@color/nav_item_text_selector"
                        android:textSize="@dimen/side_nav_text_size"
                        android:nextFocusDown="@+id/btn_home"
                        android:nextFocusRight="@+id/container" />

                    <TextView
                        android:id="@+id/btn_home"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/side_nav_item_height"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/nav_item_selector"
                        android:drawableLeft="@drawable/baseline_home_24"
                        android:drawableTint="@color/nav_item_icon_selector"
                        android:drawablePadding="@dimen/side_nav_item_icon_padding"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:text="Home"
                        android:textColor="@color/nav_item_text_selector"
                        android:textSize="@dimen/side_nav_text_size"
                        android:nextFocusUp="@+id/btn_search"
                        android:nextFocusDown="@+id/btn_movies"
                        android:nextFocusRight="@+id/container" />

                    <TextView
                        android:id="@+id/btn_movies"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/side_nav_item_height"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/nav_item_selector"
                        android:drawableLeft="@drawable/baseline_movie_24"
                        android:drawableTint="@color/nav_item_icon_selector"
                        android:drawablePadding="@dimen/side_nav_item_icon_padding"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:text="Movies"
                        android:textColor="@color/nav_item_text_selector"
                        android:textSize="@dimen/side_nav_text_size"
                        android:nextFocusUp="@+id/btn_home"
                        android:nextFocusDown="@+id/btn_webseries"
                        android:nextFocusRight="@+id/container" />

                    <TextView
                        android:id="@+id/btn_webseries"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/side_nav_item_height"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/nav_item_selector"
                        android:drawableLeft="@drawable/ic_tv"
                        android:drawableTint="@color/nav_item_icon_selector"
                        android:drawablePadding="@dimen/side_nav_item_icon_padding"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:text="Web Series"
                        android:textColor="@color/nav_item_text_selector"
                        android:textSize="@dimen/side_nav_text_size"
                        android:nextFocusUp="@+id/btn_movies"
                        android:nextFocusDown="@+id/btn_category"
                        android:nextFocusRight="@+id/container" />

                    <TextView
                        android:id="@+id/btn_category"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/side_nav_item_height"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/nav_item_selector"
                        android:drawableLeft="@drawable/baseline_category_24"
                        android:drawableTint="@color/nav_item_icon_selector"
                        android:drawablePadding="@dimen/side_nav_item_icon_padding"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:text="Categories"
                        android:textColor="@color/nav_item_text_selector"
                        android:textSize="@dimen/side_nav_text_size"
                        android:nextFocusUp="@+id/btn_webseries"
                        android:nextFocusDown="@+id/btn_mylist"
                        android:nextFocusRight="@+id/container" />

                    <TextView
                        android:id="@+id/btn_mylist"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/side_nav_item_height"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/nav_item_selector"
                        android:drawableLeft="@drawable/baseline_add_24"
                        android:drawableTint="@color/nav_item_icon_selector"
                        android:drawablePadding="@dimen/side_nav_item_icon_padding"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:text="My List"
                        android:textColor="@color/nav_item_text_selector"
                        android:textSize="@dimen/side_nav_text_size"
                        android:nextFocusUp="@+id/btn_category"
                        android:nextFocusDown="@+id/signOutBT"
                        android:nextFocusRight="@+id/container" />

                    <TextView
                        android:id="@+id/signOutBT"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/side_nav_item_height"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/nav_item_selector"
                        android:drawableLeft="@drawable/baseline_exit_to_app_24"
                        android:drawableTint="@color/nav_item_icon_selector"
                        android:drawablePadding="@dimen/side_nav_item_icon_padding"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:text="Sign Out"
                        android:textColor="@color/nav_item_text_selector"
                        android:textSize="@dimen/side_nav_text_size"
                        android:nextFocusUp="@+id/btn_mylist"
                        android:nextFocusRight="@+id/container" />

                </LinearLayout>

            </LinearLayout>

        </androidx.leanback.widget.BrowseFrameLayout>

        <!-- Sub Navigation Panel (Categories) -->
        <androidx.leanback.widget.BrowseFrameLayout
            android:id="@+id/blfSubNavBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_side_sub_nav_drawer"
            android:nextFocusLeft="@id/container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="All Categories"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ListView
                    android:id="@+id/categoryListView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:focusable="true"
                    android:nextFocusRight="@id/container" />

            </LinearLayout>

        </androidx.leanback.widget.BrowseFrameLayout>

    </LinearLayout>

</merge>