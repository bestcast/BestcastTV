<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".main_page.MainPageActivity">

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:nextFocusLeft="@id/blfNavBar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <androidx.leanback.widget.BrowseFrameLayout
            android:id="@+id/blfNavBar"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="#E2000000"
            android:nextFocusRight="@id/container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/profileImage"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:src="@drawable/default_profile" />

                    <TextView
                        android:id="@+id/profileName"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:text="profile name"
                        android:padding="5dp"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/btn_search"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:background="@drawable/selector_menu"
                        android:drawableLeft="@drawable/baseline_search_24"
                        android:drawablePadding="16dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:text="Search"
                        android:textColor="@color/text_selector_white_grey" />

                    <TextView
                        android:id="@+id/btn_home"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:background="@drawable/selector_menu"
                        android:drawableLeft="@drawable/baseline_home_24"
                        android:drawablePadding="16dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:text="Home"
                        android:textColor="@color/text_selector_white_grey" />

                    <TextView
                        android:id="@+id/btn_movies"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:background="@drawable/selector_menu"
                        android:drawableLeft="@drawable/baseline_movie_24"
                        android:drawablePadding="16dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:text="Movies"
                        android:textColor="@color/text_selector_white_grey" />

                    <TextView
                        android:id="@+id/btn_webseries"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:background="@drawable/selector_menu"
                        android:drawableLeft="@drawable/ic_tv"
                        android:drawablePadding="16dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:text="Web Series"
                        android:textColor="@color/text_selector_white_grey" />

                    <TextView
                        android:id="@+id/btn_category"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:background="@drawable/selector_menu"
                        android:drawableLeft="@drawable/baseline_category_24"
                        android:drawablePadding="16dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:text="Categories"
                        android:textColor="@color/text_selector_white_grey" />

                    <TextView
                        android:id="@+id/btn_mylist"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        
                        android:background="@drawable/selector_menu"
                        android:drawableLeft="@drawable/baseline_add_24"
                        android:drawablePadding="16dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:text="My List"
                        android:textColor="@color/text_selector_white_grey" />

                    <TextView
                        android:id="@+id/signOutBT"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:background="@drawable/selector_menu"
                        android:drawableLeft="@drawable/baseline_exit_to_app_24"
                        android:drawablePadding="16dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:text="Sign Out"
                        android:textColor="@color/text_selector_white_grey" />


                </LinearLayout>


            </LinearLayout>


        </androidx.leanback.widget.BrowseFrameLayout>

        <androidx.leanback.widget.BrowseFrameLayout
            android:id="@+id/blfSubNavBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/blfNavBar"
            android:background="#C3000000"
            android:nextFocusLeft="@id/container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/selector_menu"
                    android:drawablePadding="16dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingLeft="16dp"
                    android:text="All Categories"
                    android:textColor="@color/text_selector_white_grey"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                  <ListView
                    android:id="@+id/categoryListView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    android:nextFocusRight="@id/container"
                    />

            </LinearLayout>

        </androidx.leanback.widget.BrowseFrameLayout>
    </LinearLayout>
</merge>