<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".main_page.ui.HomeFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent=".48" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent=".07" />

    <!-- Safe-zone Left Guideline: 6% for overscan protection on all TV panels -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent=".06" />

    <!-- Hero Banner Image (16:9 proportion, anchored to top right) -->
    <ImageView
        android:id="@+id/img_banner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:src="@drawable/default_landscape"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".68" />

    <!-- Pure Black Horizontal Gradient Overlay to blend banner text smoothly into pure black -->
    <View
        android:id="@+id/gradient_horizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".78"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_center"
        android:background="@drawable/banner_gradient" />

    <!-- Pure Black Vertical Bottom Fade to seamlessly merge banner with rows below -->
    <View
        android:id="@+id/gradient_vertical"
        android:layout_width="0dp"
        android:layout_height="140dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_center"
        android:background="@drawable/banner_bottom_gradient" />

    <!-- Hero Title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:text=""
        tools:text="Bestcast Featured"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".46"
        app:layout_constraintTop_toTopOf="@+id/guideline_top"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        android:layout_height="wrap_content" />

    <!-- Hero Subtitle (Year • Certificate • Duration) -->
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:text=""
        tools:text="2024 • U/A 13+ • 2h 15m"
        android:textSize="14sp"
        android:textColor="#CCCCCC"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        android:layout_height="wrap_content" />

    <!-- Hero Description -->
    <TextView
        android:id="@+id/description"
        android:layout_width="0dp"
        android:text=""
        tools:text="Action, Adventure, Drama movie summary description goes here."
        android:textSize="13sp"
        android:textColor="#DDDDDD"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        android:lineSpacingMultiplier="1.2"
        android:ellipsize="end"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".44"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        android:layout_height="wrap_content" />

    <!-- Hero Banner Interactive Actions -->
    <LinearLayout
        android:id="@+id/hero_actions_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:nextFocusDown="@id/list_fragment"
        app:layout_constraintTop_toBottomOf="@+id/description"
        app:layout_constraintStart_toStartOf="@+id/guideline_start">

        <TextView
            android:id="@+id/btn_hero_play"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:text="▶  Play"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/hero_btn_text_color"
            android:background="@drawable/hero_btn_selector"
            android:nextFocusRight="@+id/btn_hero_details"
            android:nextFocusDown="@id/list_fragment" />

        <TextView
            android:id="@+id/btn_hero_details"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="12dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:text="ℹ  More Info"
            android:textSize="13sp"
            android:textColor="@color/hero_btn_text_color"
            android:background="@drawable/hero_btn_selector"
            android:nextFocusLeft="@+id/btn_hero_play"
            android:nextFocusDown="@id/list_fragment" />

    </LinearLayout>

    <!-- Content Rows Fragment Container (Cleanly aligned with guideline_start for unified TV visual grid) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/list_fragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:nextFocusUp="@id/btn_hero_play"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline_center"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Empty / Error Retry Layout -->
    <LinearLayout
        android:id="@+id/empty_error_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/guideline_center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/error_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unable to load content. Please check your internet connection."
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="14dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:text="Retry"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/hero_btn_text_color"
            android:background="@drawable/hero_btn_selector" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
