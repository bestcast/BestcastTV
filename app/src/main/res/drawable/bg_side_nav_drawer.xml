<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid deep dark background preventing background bleed -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8121214" />
        </shape>
    </item>
    <!-- Right vertical separator border -->
    <item
        android:left="-2dp"
        android:top="-2dp"
        android:bottom="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>